pkgdesc="an open-source implementation of the OpenGL specification, git version"
pkgver=26.2.6
pkgrel=2
arch=('x86_64')

_gallium_drivers="radeonsi"   # radeonsi only: llvmpipe/softpipe need LLVM (see build())
_vulkan_drivers="amd"                                # Only RADV

makedepends=(
